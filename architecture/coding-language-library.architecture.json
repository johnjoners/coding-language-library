  "cards": [
    {
      "dot": "cyan",
      "title": "Identity joins",
      "items": [
        "PLDB, Wikidata, and Linguist provide identity; Mason and Homebrew add tooling.",
        "Ambiguous matches remain separate and are counted for review.",
        "The Wikipedia list supplies candidates, not canonical records."
      ]
    },
    {
      "dot": "amber",
      "title": "Change handling",
      "items": [
        "Weekly checks compare HTTP validators, page revisions, QID sets, and entity modification digests.",
        "A changed source rebuilds snapshots and opens a pull request; it is never merged automatically."
      ]
    },
    {
      "dot": "violet",
      "title": "Runtime boundary",
      "items": [
        "The MCP server reads committed records; it does not install packages or launch language servers.",
        "Python with Pyright is the only adapter pairing marked tested."
      ]
    }
  ]
